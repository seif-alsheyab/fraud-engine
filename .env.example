# Copy to .env and adjust. .env is gitignored and must never be committed.
APP_ENV=development
LOG_LEVEL=info

# API listens on 4020: 4010 belongs to chargeback-iq, 3000 and 8080 are taken.
API_HOST=127.0.0.1
API_PORT=4020

# Postgres runs in Docker on 5434 so it cannot collide with chargeback-iq
# on 5433 or any other Postgres on this machine.
DATABASE_URL=postgresql://fraud:fraud_dev_pw@localhost:5434/fraud_engine

# Salt for hashing entity identifiers (card, email, device).
# Raw card numbers are NEVER stored. This salt turns an identifier into a
# stable pseudonym so the same card is recognisable across transactions
# without the value itself being recoverable from the database.
# MUST be rotated per environment and never reused between prod and dev.
ENTITY_HASH_SALT=dev_only_salt_replace_in_production

# Hard latency budget for a decision, in milliseconds. Exceeding it is a
# defect, not a slow day: a payment gateway will time out and the merchant
# loses a good sale.
DECISION_LATENCY_BUDGET_MS=250
